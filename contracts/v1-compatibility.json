{
  "version": 1,
  "requiredRoutes": [
    "/healthz:",
    "/metrics:",
    "/v1/workflows:",
    "/v1/runs:",
    "/v1/runs/{runId}:",
    "/v1/runs/{runId}/approve:",
    "/v1/runs/{runId}/cancel:",
    "/v1/audit:"
  ],
  "runStates": [
    "queued",
    "leased",
    "running",
    "awaiting_approval",
    "succeeded",
    "failed",
    "cancelled",
    "uncertain"
  ],
  "idempotencyKey": { "minimum": 16, "maximum": 128 }
}
