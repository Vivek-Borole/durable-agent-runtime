{
  "name": "durable-agent-runtime",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --if-present build && go build -o /tmp/durable-agent-runtime-worker ./services/worker",
    "dev": "pnpm --filter @dar/control-plane dev",
    "test": "pnpm -r --if-present test && go test ./...",
    "test:ts": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format:check": "prettier --check .",
    "compose:up": "docker-compose up -d",
    "compose:migrate": "docker-compose run --rm migrate",
    "compose:down": "docker-compose down --volumes",
    "fault:effects": "go run ./cmd/effect-fault",
    "benchmark:scheduling": "go build -o /tmp/durable-agent-runtime-worker ./services/worker && go run ./cmd/scheduling-benchmark",
    "evidence:check": "node scripts/validate-evidence.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  }
}
