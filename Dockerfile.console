FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/console/package.json apps/console/tsconfig.json apps/console/vite.config.ts ./apps/console/
RUN pnpm install --frozen-lockfile
COPY apps/console ./apps/console
RUN pnpm --filter @dar/console build

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY --from=build /workspace/apps/console/dist /usr/share/nginx/html
COPY infra/nginx-console.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
