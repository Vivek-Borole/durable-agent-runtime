{
  "name": "@dar/control-plane",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @dar/contracts build && tsc -p tsconfig.json",
    "dev": "pnpm --filter @dar/contracts build && tsx watch src/server.ts",
    "typecheck": "pnpm --filter @dar/contracts build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dar/contracts": "workspace:*",
    "fastify": "5.6.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "tsx": "4.23.12",
    "vitest": "4.0.7"
  }
}
