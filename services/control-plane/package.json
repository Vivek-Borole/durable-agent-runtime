{
  "name": "@dar/control-plane",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @dar/contracts build && tsc -p tsconfig.json",
    "dev": "pnpm --filter @dar/contracts build && tsx watch src/server.ts",
    "outbox": "tsx src/publish.ts",
    "typecheck": "pnpm --filter @dar/contracts build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dar/contracts": "workspace:*",
    "@fastify/cors": "11.1.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.212.0",
    "@opentelemetry/resources": "2.4.0",
    "@opentelemetry/sdk-trace-node": "2.4.0",
    "@opentelemetry/semantic-conventions": "1.37.0",
    "fastify": "5.8.5",
    "nats": "2.29.3",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "tsx": "4.23.12",
    "vitest": "4.1.0"
  }
}
